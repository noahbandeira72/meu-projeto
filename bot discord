#função da geração de senha
def gen_pass(comprimento_da_senha): 
    
    caracteres = "1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%¨&*()-_+=§?/°:;^~´´" 
    senha = "" 
    for i in range(comprimento_da_senha): 
        senha += random.choice(caracteres) 
    return senha 

comprimento_da_senha = int(input("vou criar uma senha para você! Insira o comprimento")) 
