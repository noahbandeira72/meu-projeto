#função do rolamento de dados
def dado(quantidade): 
     
    faces =[1,2,3,4,5,6] 
    resultados = [] 
    #limita a quantidade de dados que o usuario pode usar
    if quantidade > 15: 
        print("Limite máximo é 15 dados!") 
        return 
        
    for i in range(quantidade): 
        numero = random.choice(faces) 
        resultados.append(numero) 
    return resultados 

quantidade = int(input("vou lnçar um dado para você! Me diga quantos dados voce quer que eu lançe(max:15)")) 
print(dado(quantidade))

