# um bot que ajude pessoas que se preocupam com o meio ambiente e querem aprender 
# mais sobre práticas ecológicas e maneiras de reduzir o desperdício.

intents = discord.Intents.default()
intents.message_content = True

#definindo o prefixo do bot
bot = commands.Bot(command_prefix='&', intents=intents)

#comando de confirmação
@bot.event
async def on_ready():
    print(f"estamos logados como {bot.user}! ")

#comando de inicialização, ola
@bot.command(name = "ola")
